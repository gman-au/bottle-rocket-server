@using Microsoft.Extensions.Localization
@using Rocket.Api.Contracts.Transcriptions
@using Rocket.Localization.Web
@inject IStringLocalizer<TranscriptionResource> StringLocalizer
@typeparam T where T : TranscriptionSummary, new()

<MudDialog Class="p-2">
    <TitleContent>
        <MudText
            Color="Color.Primary"
            GutterBottom
            Typo="Typo.h5">
            @StringLocalizer["TranscriptionViewTitle"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                @if (ChildContent != null)
                {
                    @ChildContent(Transcription)
                }
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSimpleTable
                    Bordered
                    Dense>
                    <tbody>
                    <ComplexTableRowPair
                        Alignment="left"
                        Title="@StringLocalizer["TranscriptionExecutionFieldHeader"]">
                        <MudLink
                            Disabled="@(!Transcription.ExecutionExists)"
                            Color="Color.Secondary"
                            Href="@($"/MyExecution/{Transcription.ExecutionId}")">
                            @Transcription.ExecutionStepName
                        </MudLink>
                    </ComplexTableRowPair>
                    <SimpleTableRowPair
                        Title="@StringLocalizer["TranscriptionDateFieldHeader"]"
                        Value=@Transcription.TranscriptionDate.ToString("yyyy-MM-dd HH:mm:ss")/>
                    </tbody>
                </MudSimpleTable>
                <MudScrollToTop Selector="#scroll-images">
                    <MudFab
                        Color="Color.Default"
                        StartIcon="@Icons.Material.Filled.ArrowCircleUp"
                    />
                </MudScrollToTop>
            </MudItem>
        </MudGrid>
    </DialogContent>
</MudDialog>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public T Transcription { get; set; }

    [Parameter]
    public RenderFragment<T> ChildContent { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await
            MudDialog
                .SetOptionsAsync(
                    new DialogOptions
                    {
                        FullWidth = true,
                        CloseButton = true,
                        CloseOnEscapeKey = true,
                        MaxWidth = MaxWidth.Large,
                        BackgroundClass = "dialog-blur-backdrop"
                    }
                );
    }
}