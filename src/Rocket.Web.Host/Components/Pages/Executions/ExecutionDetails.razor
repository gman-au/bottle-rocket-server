@page "/MyExecution/{id}"
@using Microsoft.Extensions.Localization
@using Rocket.Api.Contracts.Executions
@using Rocket.Domain.Enum
@using Rocket.Domain.Utils
@using Rocket.Interfaces
@using Rocket.Localization.Web
@using Rocket.Web.Host.Components.Dialog
@using Rocket.Web.Host.Extensions
@using Rocket.Web.Host.HubClients
@using Rocket.Web.Host.Infrastructure
@using Rocket.Web.Infrastructure.Client
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICaptureHubClient CaptureHubClient
@inject IApiRequestManager ApiRequestManager
@inject IWebHostErrorHandler WebHostErrorHandler
@inject IExecutionMermaidConverter ExecutionMermaidConverter
@inject IStringLocalizer<ExecutionsResource> StringLocalizer
@inherits Rocket.Web.Host.Infrastructure.BaseSecureCancellableComponent

<BottleRocketLoadingOverlay IsLoading="@_isLoading">
    @if (_currentModel != null)
    {
        <MudPaper Class="p-4" elevation="2">
            <MudGrid Class="pa-8" Justify="Justify.SpaceEvenly">
                <MudItem sm="12" md="6">
                    <MudStack
                        Style="height:100%;"
                        Justify="Justify.SpaceBetween"
                        StretchItems="StretchItems.Middle"
                        AlignItems="AlignItems.Start">
                        <MudText
                            Align="Align.Center"
                            Typo="Typo.h4"
                            Color="Color.Primary"
                            Class="mb-4">
                            @StringLocalizer["ExecutionsDetailsTitle"]
                        </MudText>
                        <div style="text-align: center; width:100%">
                            <MudSimpleTable
                                Bordered
                                Dense>
                                <tbody>
                                <ComplexTableRowPair Title="@StringLocalizer["ExecutionsNameFieldHeader"]">
                                    <MudLink Color="Color.Secondary" Href=@($"/MyWorkflow/{_currentModel.WorkflowId}")>
                                        <MudText
                                            Class="code-text"
                                            Typo="Typo.body1"
                                            Align="Align.Left"
                                            GutterBottom="true">
                                            @_currentModel.Name
                                        </MudText>
                                    </MudLink>
                                </ComplexTableRowPair>
                                <ComplexTableRowPair
                                    Title="@StringLocalizer["ExecutionsStatusFieldHeader"]">
                                    <span style="display:flex;">
                                        <MudText
                                            Color="@(_currentModel.ExecutionStatus.MapStatusToColor())"
                                            Class="code-text"
                                            Typo="Typo.body1"
                                            Align="Align.Left"
                                            GutterBottom="true">
                                            @(DomainConstants.ExecutionStatusTypes.ContainsKey((int)_currentModel.ExecutionStatus) ? DomainConstants.ExecutionStatusTypes[(int)_currentModel.ExecutionStatus] : StringLocalizer["ExecutionsStatusUnknownValue"])
                                        </MudText>
                                        @if (_currentModel.ExecutionStatus == (int)ExecutionStatusEnum.Running)
                                        {
                                            <div class="ml-2">
                                                <MudProgressCircular Color="Color.Info" Size="Size.Small" Indeterminate="true"/>
                                            </div>
                                        }
                                    </span>
                                </ComplexTableRowPair>
                                <SimpleTableRowPair Title="@StringLocalizer["ExecutionsRunDateFieldHeader"]"
                                                    Value=@_currentModel?.RunDate?.ToString("g")/>
                                <ComplexTableRowPair Title="@StringLocalizer["ExecutionsImageFieldHeader"]">
                                    <MudLink Href=@($"/MyScans/{_currentModel.BatchId}")>
                                        @if (!string.IsNullOrEmpty(_currentModel.CoverContentType) && !string.IsNullOrEmpty(_currentModel.CoverThumbnailBase64))
                                        {
                                            <MudImage
                                                Class="mud-border-secondary border rounded my-2"
                                                Src=@($"data:{_currentModel.CoverContentType};base64,{_currentModel.CoverThumbnailBase64}")
                                                Width="200"
                                                Height="200"/>
                                        }
                                        else
                                        {
                                            <MudIcon
                                                Size="Size.Large"
                                                Class="broken-image"
                                                Icon="@StandardIcons.NoImageIcon"
                                            />
                                        }
                                    </MudLink>
                                </ComplexTableRowPair>
                                </tbody>
                            </MudSimpleTable>
                        </div>
                        <MudGrid Class="align-start" Justify="Justify.FlexEnd">
                            <MudItem>
                                <MudButton
                                    Variant="Variant.Outlined"
                                    Color="Color.Error"
                                    Disabled="@(_currentModel.ExecutionStatus == (int)ExecutionStatusEnum.Running)"
                                    OnClick="@(ConfirmDeleteAsync)">
                                    @StringLocalizer["ExecutionsDeleteCaption"]
                                </MudButton>
                            </MudItem>
                            <MudItem>
                                <GoBackButton/>
                            </MudItem>
                            <MudItem>
                                <MudButton
                                    Variant="Variant.Outlined"
                                    Color="Color.Warning"
                                    Disabled="@(_currentModel.ExecutionStatus != (int)ExecutionStatusEnum.Running)"
                                    OnClick="@ConfirmCancelAsync">
                                    @StringLocalizer["ExecutionsCancelCaption"]
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudItem>
                <MudItem sm="12" md="6">
                    <MudPaper Elevation="4" Class="p-4 mermaid-paper">
                        @if (_showMermaid)
                        {
                            <pre class="mermaid">
@MermaidText
        </pre>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem sm="12">
                    <div class="mud-border-tertiary border p-4 rounded" id="scroll-images" style="height: 600px; overflow-y: auto;">
                        <MudGrid Spacing="1" Justify="Justify.FlexStart">
                            @foreach (var element in _currentModel.Elements)
                            {
                                <MudItem
                                    Class="d-flex align-center justify-center"
                                    xs="12" sm="12" md="12" lg="6" xl="3">
                                    <MudStack
                                        Row
                                        Style="height:100%;"
                                        Justify="Justify.SpaceBetween"
                                        StretchItems="StretchItems.None"
                                        AlignItems="AlignItems.Center">
                                        <MudBadge
                                            Icon="@GetIconFromStatus(element.ExecutionStatus)"
                                            Color="@(GetColorFromStatus(element.ExecutionStatus))"
                                        >
                                            <MudImage
                                                @onclick="@(async () => await LoadAndPreviewScanAsync(
                                                              _currentModel.BatchId,
                                                              element.ScanId
                                                          ))"
                                                Class="rounded mb-4"
                                                Style="cursor: zoom-in;"
                                                src=@($"data:{element.ContentType};base64,{element.ThumbnailBase64}")
                                                Fluid
                                            />
                                        </MudBadge>
                                        <MudFab
                                            Size="Size.Small"
                                            Color="Color.Default"
                                            Disabled="@(!_currentModel.ExecutionStatus.MapStatusToFinished())"
                                            StartIcon="@StandardIcons.LogsIcon"
                                            OnClick="@(async () => await DisplayExecutionElementLogMessages(element.Id))"
                                        />
                                    </MudStack>
                                </MudItem>
                            }
                        </MudGrid>
                        <MudScrollToTop Selector="#scroll-images">
                            <MudFab Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.ArrowCircleUp"/>
                        </MudScrollToTop>
                    </div>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
</BottleRocketLoadingOverlay>

@code {

    private bool _disposed = false;
    private bool _isLoading;
    private bool _isConnected;
    private bool _showMermaid = true;
    private ExecutionSummary _currentModel = null;

    [Parameter]
    public string Id { get; set; }

    private string MermaidText { get; set; }

    private DotNetObjectReference<ExecutionDetails> _dotNetRef;

    protected override async Task OnAfterRenderAsync(
        bool firstRender
    )
    {
        if (firstRender)
        {
            _dotNetRef =
                DotNetObjectReference
                    .Create(this);

            await
                JsRuntime
                    .InvokeVoidAsync(
                        "storeDotNetRef",
                        _dotNetRef
                    );

            await
                Task
                    .Delay(100);

            await
                JsRuntime
                    .InvokeVoidAsync("mermaid.run");

            // Set up SignalR listener
            CaptureHubClient.OnNewExecutionUpdateReceived += HandleExecutionUpdate;
            CaptureHubClient.OnNewExecutionElementUpdateReceived += HandleExecutionElementUpdate;

            // Connect to hub
            await
                CaptureHubClient
                    .StartAsync();

            _isConnected =
                CaptureHubClient
                    .IsConnected;
        }
    }

    [JSInvokable]
    public void NavigateToRoute(
        string route
    )
    {
        if (_disposed)
            return;

        NavigationManager
            .NavigateTo(route);
    }

    public override void Dispose()
    {
        if (!_disposed)
        {
            _disposed = true;

            _dotNetRef?
                .Dispose();

            base
                .Dispose();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await
                base
                    .OnInitializedAsync();

            _isLoading = true;

            await
                ReloadExecutionDetailsAsync();
        }
        catch (Exception ex)
        {
            await
                WebHostErrorHandler
                    .HandleExceptionAsync(ex);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReloadExecutionDetailsAsync()
    {
        _currentModel =
            await
                ApiRequestManager
                    .Executions
                    .GetExecutionByIdAsync(
                        Id,
                        BaseCancellationToken
                    );

        MermaidText =
            ExecutionMermaidConverter
                .Convert(_currentModel);
    }

    private async Task HandleExecutionElementUpdate(
        string scanId,
        int status
    )
    {
        var elements = 
            _currentModel
                .Elements
                .ToList();
        
        var element = 
            elements
            .FirstOrDefault(x => x.ScanId == scanId);

        if (element != null)
        {
            var newElement =
                new ExecutionElementSummary
                {
                    Id = element.Id,
                    ScanId = element.ScanId,
                    ExecutionStatus = status,
                    LogMessages = element.LogMessages,
                    ThumbnailBase64 = element.ThumbnailBase64,
                    ContentType = element.ContentType,
                    Vendor = element.Vendor
                };
            
            var index = elements.IndexOf(element);
            
            elements
                .Remove(element);
            
            elements
                .Insert(
                index,
                newElement
            );

            _currentModel.Elements = elements;
            
            await 
                InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleExecutionUpdate()
    {
        await
            InvokeAsync(async () =>
                {
                    try
                    {
                        _isLoading = true;
                        StateHasChanged();

                        // new capture would be the most recent; get the latest record
                        await
                            ReloadExecutionDetailsAsync();

                        await
                            RefreshMermaidDiagramAsync();

                        await
                            Task
                                .Delay(100);
                    }
                    catch (Exception ex)
                    {
                        await
                            WebHostErrorHandler
                                .HandleExceptionAsync(ex);
                    }
                    finally
                    {
                        _isLoading = false;
                        StateHasChanged(); // Force UI update after loading
                    }
                }
            );
    }

    private async Task RefreshMermaidDiagramAsync()
    {
        // Hide the element completely
        _showMermaid = false;
        StateHasChanged();
        await Task.Delay(50);

        // Show it again with new content
        _showMermaid = true;
        StateHasChanged();
        await Task.Delay(100);

        // Now run Mermaid on the fresh element
        await
            JsRuntime
                .InvokeVoidAsync("mermaid.run");
    }

    public async ValueTask DisposeAsync()
    {
        // Clean up SignalR subscription
        CaptureHubClient.OnNewExecutionUpdateReceived -= HandleExecutionUpdate;

        await
            CaptureHubClient
                .DisposeAsync();
    }

    [JSInvokable]
    public async Task DisplayExecutionStepLogMessages(
        string executionStepId
    )
    {
        var step =
            Flatten(_currentModel.Steps)
                .FirstOrDefault(o => o.Id == executionStepId);

        if (step == null) return;

        var logMessages = step.LogMessages ?? [];

        await
            DialogService
                .ShowAsync<ExecutionMessageDialog>(
                    null,
                    new DialogParameters
                    {
                        { "LogMessages", logMessages }
                    }
                );
    }

    public async Task DisplayExecutionElementLogMessages(
        string executionElementId
    )
    {
        var element =
            _currentModel.Elements
                .FirstOrDefault(o => o.Id == executionElementId);

        if (element == null) return;

        var logMessages = element.LogMessages ?? [];

        await
            DialogService
                .ShowAsync<ExecutionMessageDialog>(
                    null,
                    new DialogParameters
                    {
                        { "LogMessages", logMessages }
                    }
                );
    }

    private static IEnumerable<ExecutionStepSummary> Flatten(
        IEnumerable<ExecutionStepSummary> source
    )
    {
        foreach (var item in source)
        {
            yield return item;
            foreach (var child in Flatten(item.ChildSteps))
                yield return child;
        }
    }

    private async Task ConfirmCancelAsync()
    {
        var dialog =
            await
                DialogService
                    .ShowAsync<ConfirmCancelExecutionDialog>(
                        null
                    );

        var result =
            await
                dialog
                    .Result;

        if (!(result?.Canceled ?? true))
        {
            try
            {
                _isLoading = true;
                StateHasChanged();

                await
                    ApiRequestManager
                        .Executions
                        .CancelExecutionAsync(
                            _currentModel.Id,
                            BaseCancellationToken
                        );
            }
            catch (Exception ex)
            {
                await
                    WebHostErrorHandler
                        .HandleExceptionAsync(ex);
            }
            finally
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        var batchId = _currentModel.BatchId;

        var dialog =
            await
                DialogService
                    .ShowAsync<ConfirmDeleteExecutionDialog>(
                        null
                    );

        var result =
            await
                dialog
                    .Result;

        if (!(result?.Canceled ?? true))
        {
            try
            {
                _isLoading = true;
                StateHasChanged();

                await
                    ApiRequestManager
                        .Executions
                        .DeleteExecutionByIdAsync(
                            _currentModel.Id,
                            BaseCancellationToken
                        );

                Snackbar
                    .Add(
                        StringLocalizer["ExecutionsHasBeenDeletedMessage"].Value,
                        Severity.Success
                    );

                NavigationManager
                    .NavigateTo($"/MyScans/{batchId}");
            }
            catch (Exception ex)
            {
                await
                    WebHostErrorHandler
                        .HandleExceptionAsync(ex);
            }
            finally
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadAndPreviewScanAsync(
        string batchId,
        string scanId
    )
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            var scan =
                await
                    ApiRequestManager
                        .Scans
                        .GetMyScanAsync(
                            batchId,
                            scanId,
                            BaseCancellationToken
                        );

            if (scan != null)
            {
                var dialog =
                    await
                        DialogService
                            .ShowAsync<PreviewScanDialog>(
                                null,
                                new DialogParameters
                                {
                                    { "Scan", scan }
                                }
                            );

                await
                    dialog
                        .Result;
            }
        }
        catch (Exception ex)
        {
            await
                WebHostErrorHandler
                    .HandleExceptionAsync(ex);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private static Color GetColorFromStatus(
        int status
    )
    {
        return status switch
        {
            (int)ExecutionStatusEnum.Completed => Color.Success,
            (int)ExecutionStatusEnum.Errored => Color.Error,
            (int)ExecutionStatusEnum.Running => Color.Info,
            _ => Color.Default
        };
    }

    private static string GetIconFromStatus(
        int status
    )
    {
        return status switch
        {
            (int)ExecutionStatusEnum.Completed => StandardIcons.SuccessIcon,
            (int)ExecutionStatusEnum.Errored => StandardIcons.FailureIcon,
            (int)ExecutionStatusEnum.Running => StandardIcons.RunningIcon,
            _ => StandardIcons.NotRunIcon
        };
    }

}