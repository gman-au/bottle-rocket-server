@page "/MyWorkflow/ConvertToPdf/{workflowId}/AddStep"
@page "/MyWorkflow/ConvertToPdf/{workflowId}/Steps/{parentStepId}/AddStep"
@page "/MyWorkflow/ConvertToPdf/{workflowId}/Steps/{stepId}/UpdateStep"
@using Rocket.QuestPdf.Contracts
@inherits Rocket.Web.Host.Infrastructure.BaseSecureCancellableComponent

<UpdateWorkflowStepWrapper
    T="ConvertToPdfWorkflowStepSpecifics"
    WorkflowStepName="Convert to PDF"
    WorkflowId="@WorkflowId"
    ParentStepId="@ParentStepId"
    StepId="@StepId"
    Context="stepSpecifics">
    <MudGrid>
        <MudItem sm="12">
            <MudItem sm="12" lg="6" xl="4">
                <MudCheckBox
                    TriState
                    @bind-Value="@stepSpecifics.MergeFiles">
                    Merge all files into one single PDF
                </MudCheckBox>
            </MudItem>
            <MudText
                type="hidden"
                T="string"
                @bind-Value="stepSpecifics.InputTypeName"
                For="@(() => stepSpecifics.InputTypeName)"/>
        </MudItem>
    </MudGrid>
</UpdateWorkflowStepWrapper>

@code {

    [Parameter]
    public string WorkflowId { get; set; }

    [Parameter]
    public string ParentStepId { get; set; }

    [Parameter]
    public string StepId { get; set; }

}