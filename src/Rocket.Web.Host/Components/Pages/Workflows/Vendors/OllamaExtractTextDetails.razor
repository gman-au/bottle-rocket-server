@page "/MyWorkflow/Ollama/ExtractText/{workflowId}/AddStep"
@page "/MyWorkflow/Ollama/ExtractText/{workflowId}/Steps/{parentStepId}/AddStep"
@page "/MyWorkflow/Ollama/ExtractText/{workflowId}/Steps/{stepId}/UpdateStep"
@using Rocket.Ollama.Contracts
@using Rocket.Ollama.Contracts.Text
@using Rocket.Ollama.Domain
@using Rocket.Web.Infrastructure.Client

@using Rocket.Web.Host.Infrastructure
@inherits Rocket.Web.Host.Infrastructure.BaseSecureCancellableComponent
@inject IWebHostErrorHandler WebHostErrorHandler
@inject IApiRequestManager ApiRequestManager

<UpdateWorkflowStepWrapper
    @ref="_wrapper"
    T="OllamaExtractTextWorkflowStepSpecifics"
    WorkflowStepName="Extract text from image"
    WorkflowId="@WorkflowId"
    ParentStepId="@ParentStepId"
    RequiresConnectorCode="@OllamaDomainConstants.ConnectorCode"
    OnConnectorIdChanged="ConnectorChangedAsync"
    StepId="@StepId"
    Context="stepSpecifics">
    <MudGrid>
        <MudItem sm="12" lg="6">
            <MudSelect
                T="OllamaModel"
                Label=@(_isLoading ? "Loading..." : "Select an Ollama model")
                @bind-Value="@_modelSelected"
                Required="true"
                RequiredError="Model name is required"
                HelperText="Enter the Ollama model name to use for OCR extraction"
                @bind-Value:after="() => SectionIdChangedAsync(stepSpecifics)"
                Disabled="@(_isLoading || string.IsNullOrEmpty(_connectorId))"
                Clearable
            >
                @foreach (var ollamaModel in _ollamaModels ?? [])
                {
                    <MudSelectItem
                        T="OllamaModel"
                        Value="@ollamaModel">
                        <MudStack Spacing="0">
                            <MudItem>
                                <MudText
                                    Typo="Typo.body1">
                                    @ollamaModel.Model
                                </MudText>
                            </MudItem>
                            <MudItem>
                                <MudText
                                    Color="Color.Info"
                                    Typo="Typo.subtitle2">
                                    @(string.Join(", ", ollamaModel.Capabilities))
                                </MudText>
                            </MudItem>
                        </MudStack>
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
</UpdateWorkflowStepWrapper>

@code {

    [Parameter]
    public string WorkflowId { get; set; }

    [Parameter]
    public string ParentStepId { get; set; }

    [Parameter]
    public string StepId { get; set; }

    private bool _isLoading;

    private string _connectorId;

    private UpdateWorkflowStepWrapper<OllamaExtractTextWorkflowStepSpecifics> _wrapper;

    private OllamaModel _modelSelected;

    private IEnumerable<OllamaModel> _ollamaModels = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await
                base
                    .OnInitializedAsync();

            _isLoading = true;
            StateHasChanged();

            await
                RefreshOllamaModelsAsync();
        }
        catch (Exception ex)
        {
            await
                WebHostErrorHandler
                    .HandleExceptionAsync(ex);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshOllamaModelsAsync()
    {
        try
        {
            if (!string.IsNullOrEmpty(_connectorId))
            {
                _isLoading = true;
                StateHasChanged();

                var response =
                    await
                        ApiRequestManager
                            .Vendors
                            .Ollama
                            .GetOllamaModelsAsync(
                                new OllamaListModelsRequest
                                {
                                    ConnectorId = _connectorId
                                },
                                BaseCancellationToken
                            );

                _ollamaModels =
                    response?
                        .Models ?? [];

                _modelSelected =
                    _ollamaModels
                        .FirstOrDefault(o => _wrapper?.StepSpecifics?.ModelName == o.Model);
            }
            else
            {
                _ollamaModels = [];
            }
        }
        catch (Exception ex)
        {
            await
                WebHostErrorHandler
                    .HandleExceptionAsync(ex);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }

        StateHasChanged();
    }

    private async Task SectionIdChangedAsync(
        OllamaExtractTextWorkflowStepSpecifics stepSpecifics
    )
    {
        stepSpecifics.ModelName =
            _modelSelected?
                .Model;
    }

    private async Task ConnectorChangedAsync(
        string connectorId
    )
    {
        _connectorId = connectorId;

        if (string.IsNullOrEmpty(connectorId))
        {
            _modelSelected = null;
        }

        await
            RefreshOllamaModelsAsync();
    }

}