@page "/MyScans/{id}"
@using Microsoft.Extensions.Localization
@using Rocket.Api.Contracts.Batches
@using Rocket.Api.Contracts.Executions
@using Rocket.Api.Contracts.Workflows
@using Rocket.Localization.Web
@using Rocket.Web.Host.Components.Dialog
@using Rocket.Web.Host.Infrastructure
@using Rocket.Web.Infrastructure.Client
@inject IApiRequestManager ApiRequestManager
@inject IWebHostErrorHandler WebHostErrorHandler
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ScansResource> StringLocalizer
@inject IJSRuntime JsRuntime
@inherits Rocket.Web.Host.Infrastructure.BaseSecureCancellableComponent

<BottleRocketLoadingOverlay IsLoading="@_isLoading">
    <MudPaper Class="p-4" elevation="2">
        @if (_batchSpecifics != null)
        {
            <MudGrid Class="pa-4" Justify="Justify.SpaceEvenly">
                <MudItem xs="12" sm="6">
                    @if (_batchSpecifics.Archived)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height:100%;">
                            <MudIcon
                                Size="Size.Large"
                                Class="broken-image"
                                Icon="@StandardIcons.NoImageIcon"
                                Title="@StringLocalizer["ScansWasArchivedMessage"]"/>

                            <MudText
                                Typo="Typo.h4"
                                Class="broken-image"
                            >
                                Archived
                            </MudText>
                        </MudStack>
                    }
                    else
                    {
                        <div class="mud-border-tertiary border p-4 rounded" id="scroll-images" style="height: 600px; overflow-y: auto;">
                            <MudGrid Spacing="1" Justify="Justify.FlexStart">
                                @foreach (var scan in _batchSpecifics.Scans)
                                {
                                    <MudItem
                                        Class="d-flex align-center justify-center"
                                        xs="12" sm="12" md="12" lg="12" xl="6">
                                        <MudImage
                                            @onclick="@(async () => await LoadAndPreviewScanAsync(scan.Id))"
                                            Class="rounded mb-4"
                                            Style="cursor: zoom-in;"
                                            src=@($"data:{scan.ContentType};base64,{scan.ThumbnailBase64}")
                                            Fluid/>
                                        <MudMenu
                                            Dense
                                            Icon="@StandardIcons.SubMenuIcon"
                                            Color="Color.Default"
                                            Variant="Variant.Text"
                                        >
                                            <MudMenuItem
                                                Icon="@StandardIcons.DownloadIcon"
                                                OnClick="@(async () => await DownloadFileAsync(scan.Id))"
                                                Label="@StringLocalizer["ScansDownloadCaption"]"/>
                                            <MudMenuItem
                                                Icon="@StandardIcons.DeleteIcon"
                                                OnClick="@(() => ConfirmDeleteAsync(scan.Id))"
                                                Label="@StringLocalizer["ScansDeleteCaption"]"/>
                                        </MudMenu>
                                    </MudItem>
                                }
                            </MudGrid>
                            <MudScrollToTop Selector="#scroll-images">
                                <MudFab Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.ArrowCircleUp"/>
                            </MudScrollToTop>
                        </div>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack
                        Style="height:100%;"
                        Justify="Justify.SpaceBetween"
                        StretchItems="StretchItems.Middle"
                        AlignItems="AlignItems.Start">
                        <div style="width:100%;">
                            <MudText
                                Align="Align.Center"
                                Typo="Typo.h4"
                                Color="Color.Primary"
                                Class="mb-4">
                                @StringLocalizer["ScansDetailsTitle"]
                            </MudText>
                        </div>
                        <div style="width:100%;">
                            <MudSimpleTable
                                Bordered
                                Dense>
                                <tbody>
                                <SimpleTableRowPair
                                    Title="@StringLocalizer["ScansDescriptionFieldHeader"]"
                                    Value=@_batchSpecifics.Description/>
                                <SimpleTableRowPair
                                    Title="@StringLocalizer["ScansCaptureDateFieldHeader"]"
                                    Value=@_batchSpecifics.DateScanned.ToString("yyyy-MM-dd HH:mm:ss")/>
                                <SimpleTableRowPair
                                    Title="@StringLocalizer["ScansStatusFieldHeader"]"
                                    Value=@(_batchSpecifics.Archived ? StringLocalizer["ScansArchivedValue"] : StringLocalizer["ScansActiveValue"])
                                    ValueColor="@(_batchSpecifics.Archived ? Color.Warning : Color.Success)"/>
                                </tbody>
                            </MudSimpleTable>
                        </div>
                        @if (!_batchSpecifics.Archived)
                        {
                            <div class="mud-border-tertiary border p-4 rounded">
                                <MudText
                                    Typo="Typo.h5"
                                    Color="Color.Primary">
                                    @StringLocalizer["ScansManuallyTriggerTitle"]
                                </MudText>
                                <MudText
                                    Typo="Typo.body1">
                                    @StringLocalizer["ScansManuallyTriggerMessage"]
                                </MudText>
                                <MudGrid Class="mt-2" Justify="Justify.SpaceBetween">
                                    <MudItem xs="12">
                                        <MudSelect
                                            T="string"
                                            Label="@StringLocalizer["ScansManuallyTriggerFieldHeader"]"
                                            @bind-Value="@_workflowIdToTrigger"
                                            HelperText="@StringLocalizer["ScansManuallyTriggerFieldHint"]"
                                            Clearable="true"
                                            Required="false">
                                            @foreach (var workflow in _availableWorkflows ?? [])
                                            {
                                                <MudSelectItem Value="@workflow.Id">
                                                    @workflow.Name
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudButton
                                            Disabled="@(string.IsNullOrEmpty(_workflowIdToTrigger))"
                                            OnClick="@(async () => await ConfirmTriggerWorkflowAsync())"
                                            Variant="Variant.Outlined"
                                            Color="Color.Success">
                                            @StringLocalizer["ScansRunWorkflowCaption"]
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>
                            </div>
                        }
                        <MudDivider/>
                        <MudGrid Class="align-start" Justify="Justify.FlexEnd">
                            <MudItem>
                                <GoBackButton BackPath="/MyScans"/>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudItem>
                <MudFlexBreak/>
                <MudDivider Class="mt-4"/>
                <MudItem xs="12">
                    <MudText
                        Align="Align.Center"
                        Typo="Typo.h5"
                        Color="Color.Primary"
                        Class="mb-4">
                        @StringLocalizer["ScansPreviousRunsTitle"]
                    </MudText>
                </MudItem>
                <PreviousWorkflowRuns Executions="@_executions"/>
            </MudGrid>
        }
    </MudPaper>
</BottleRocketLoadingOverlay>

@code {
    private bool _isLoading;
    private BatchSpecifics _batchSpecifics = null;
    private string _workflowIdToTrigger = null;

    [Parameter]
    public string Id { get; set; }

    private IEnumerable<MyWorkflowSummary> _availableWorkflows = [];
    private IEnumerable<ExecutionSummary> _executions = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await
                base
                    .OnInitializedAsync();

            _isLoading = true;
            StateHasChanged();

            _batchSpecifics =
                await
                    ApiRequestManager
                        .Batches
                        .GetMyBatchAsync(
                            Id,
                            BaseCancellationToken
                        );

            _availableWorkflows =
                (await
                    ApiRequestManager
                        .Workflows
                        .GetWorkflowsAsync(
                            new FetchWorkflowsRequest
                            {
                                StartIndex = null,
                                RecordCount = null
                            },
                            BaseCancellationToken
                        )
                ).Workflows;

            _executions =
                (await
                    ApiRequestManager
                        .Executions
                        .GetExecutionsAsync(
                            new FetchExecutionsRequest
                            {
                                ScanId = Id,
                            }, BaseCancellationToken
                        ))?
                .Executions;
        }
        catch (Exception ex)
        {
            await
                WebHostErrorHandler
                    .HandleExceptionAsync(ex);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAndPreviewScanAsync(
        string scanId
    )
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            var scan =
                await
                    ApiRequestManager
                        .Scans
                        .GetMyScanAsync(
                            _batchSpecifics.Id,
                            scanId,
                            BaseCancellationToken
                        );

            if (scan != null)
            {
                var dialog =
                    await
                        DialogService
                            .ShowAsync<PreviewScanDialog>(
                                null,
                                new DialogParameters
                                {
                                    { "Scan", scan }
                                }
                            );

                await
                    dialog
                        .Result;
            }
        }
        catch (Exception ex)
        {
            await
                WebHostErrorHandler
                    .HandleExceptionAsync(ex);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmTriggerWorkflowAsync()
    {
        var dialog =
            await
                DialogService
                    .ShowAsync<ConfirmTriggerWorkflowDialog>();

        var result =
            await
                dialog
                    .Result;

        if (!(result?.Canceled ?? true))
        {
            try
            {
                _isLoading = true;
                StateHasChanged();

                var execution =
                    await
                        ApiRequestManager
                            .Executions
                            .CreateExecutionAsync(
                                new CreateExecutionRequest
                                {
                                    WorkflowId = _workflowIdToTrigger,
                                    ScanId = Id,
                                    RunImmediately = true
                                },
                                BaseCancellationToken
                            );

                if (execution != null)
                {
                    try
                    {
                        var response =
                            await
                                ApiRequestManager
                                    .Executions
                                    .StartExecutionAsync(
                                        execution.Id,
                                        BaseCancellationToken
                                    );

                        if (response.IsStarted)
                        {
                            Snackbar
                                .Add(
                                    StringLocalizer["ScansWorkflowWasTriggeredMessage"].Value,
                                    Severity.Success
                                );
                        }
                    }
                    catch (Exception ex)
                    {
                        await
                            WebHostErrorHandler
                                .HandleExceptionAsync(ex);
                    }

                    NavigationManager
                        .NavigateTo($"/MyExecution/{execution.Id}");
                }
            }
            catch (Exception ex)
            {
                await
                    WebHostErrorHandler
                        .HandleExceptionAsync(ex);
            }
            finally
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task DownloadFileAsync(string scanId)
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            var scan =
                await
                    ApiRequestManager
                        .Scans
                        .GetMyScanAsync(
                            _batchSpecifics.Id,
                            scanId,
                            BaseCancellationToken
                        );
            
            var fileName = scan.Id;
            var contentType = scan.ContentType;
            var base64Data = scan?.ImageBase64;

            if (!string.IsNullOrEmpty(base64Data))
            {
                if (base64Data.Contains(","))
                {
                    base64Data = base64Data.Split(',')[1];
                }

                await
                    JsRuntime
                        .InvokeVoidAsync(
                            "downloadBase64File",
                            fileName,
                            contentType,
                            base64Data
                        );
            }
            else
            {
                throw new Exception(StringLocalizer["ScansNoFileDataError"].Value);
            }
        }
        catch (Exception ex)
        {
            await
                WebHostErrorHandler
                    .HandleExceptionAsync(ex);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
    
    private async Task ConfirmDeleteAsync(
        string id
    )
    {
        var dialog =
            await
                DialogService
                    .ShowAsync<ConfirmDeleteScanDialog>(
                        null
                    );

        var result =
            await
                dialog
                    .Result;

        if (!(result?.Canceled ?? true))
        {
            try
            {
                _isLoading = true;
                StateHasChanged();

                await
                    ApiRequestManager
                        .Scans
                        .DeleteScanByIdAsync(
                            _batchSpecifics.Id,
                            id,
                            BaseCancellationToken
                        );

                _batchSpecifics.Scans =
                    _batchSpecifics.Scans
                        .Where(o => o.Id != id);

                Snackbar
                    .Add(
                        StringLocalizer["ScansWasDeletedMessage"].Value,
                        Severity.Success
                    );
            }
            catch (Exception ex)
            {
                await
                    WebHostErrorHandler
                        .HandleExceptionAsync(ex);
            }
            finally
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }
}