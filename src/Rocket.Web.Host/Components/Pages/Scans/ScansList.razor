@page "/MyScans"
@using Microsoft.Extensions.Localization
@using Rocket.Api.Contracts.Batches
@using Rocket.Localization.Web
@using Rocket.Web.Host.Components.Dialog
@using Rocket.Web.Host.HubClients
@using Rocket.Web.Host.Infrastructure
@using Rocket.Web.Infrastructure.Client
@implements IAsyncDisposable
@inject IApiRequestManager ApiRequestManager
@inject ISnackbar Snackbar
@inject ICaptureHubClient CaptureHubClient
@inject IWebHostErrorHandler WebHostErrorHandler
@inject IDialogService DialogService
@inject IStringLocalizer<ScansResource> StringLocalizer
@inherits Rocket.Web.Host.Infrastructure.BaseSecureCancellableComponent

<MudText
    Align="Align.Center"
    Typo="Typo.h4"
    Color="Color.Primary"
    Class="mb-4">
    @StringLocalizer["ScansListTitle"]
</MudText>
<BottleRocketLoadingOverlay IsLoading="@_isLoading">
    @if ((_batches ?? []).Any())
    {
        <MudGrid Justify="Justify.FlexStart" Class="pa-4">
            @foreach (var batch in _batches)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Style="height:100%;" Outlined>
                        <MudCardMedia
                            Style="cursor:pointer;"
                            @onclick="@(() => NavigationManager.NavigateTo($"/MyScans/{batch.Id}"))"
                            Image=@($"data:{batch.CoverContentType};base64,{batch.CoverThumbnailBase64}") Width="200" Height="200"/>
                        <MudCardContent>
                            <MudText Typo="Typo.caption">@(batch.DateScanned.ToString("g"))</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Primary">@batch.ScanCount @StringLocalizer["ScansPagesCaption"]</MudText>
                        </MudCardContent>
                        <MudCardActions Class="justify-end">
                            <MudMenu Dense Icon="@StandardIcons.SubMenuIcon">
                                <MudMenuItem
                                    Icon="@StandardIcons.InspectIcon"
                                    IconColor="Color.Secondary"
                                    Label="@StringLocalizer["ScansDetailsCaption"]"
                                    @onclick="@(() => NavigationManager.NavigateTo($"/MyScans/{batch.Id}"))"
                                />
                                <MudMenuItem
                                    Icon="@StandardIcons.DeleteIcon"
                                    Label="@StringLocalizer["ScansDeleteCaption"]"
                                    OnClick="@(() => ConfirmDeleteAsync(batch.Id))"
                                />
                            </MudMenu>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
        <MudDivider Class="my-4"/>
        <MudGrid Justify="Justify.Center">
            <MudItem>
                <MudButton
                    Variant="Variant.Outlined"
                    Color="Color.Primary"
                    Disabled="@_noMoreRecords"
                    @onclick="@(async () => await LoadBatchesAsync(
                                  _currentIndex,
                                  DefaultPageSize
                              ))">
                    @StringLocalizer["ScansLoadMoreCaption"]
                </MudButton>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MudText
            Align="Align.Center"
            Typo="Typo.body2"
            Color="Color.Default">
            @StringLocalizer["ScansNoScansMessage"]
        </MudText>
    }
</BottleRocketLoadingOverlay>

@code {
    private const int DefaultPageSize = 12;
    private bool _isLoading;
    private bool _isConnected;
    private bool _noMoreRecords = false;
    private int _currentIndex = 0;
    private IEnumerable<BatchSummary> _batches = [];

    protected override async Task OnAfterRenderAsync(
        bool firstRender
    )
    {
        if (!firstRender) return;

        try
        {
            CaptureHubClient.OnNewCaptureReceived += HandleNewCapture;

            await
                CaptureHubClient
                    .StartAsync();

            _isConnected =
                CaptureHubClient
                    .IsConnected;
        }
        catch (Exception ex)
        {
            await
                WebHostErrorHandler
                    .HandleExceptionAsync(ex);
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await
                base
                    .OnInitializedAsync();

            _isLoading = true;

            await
                LoadBatchesAsync(
                    _currentIndex,
                    DefaultPageSize
                );
        }
        catch (Exception ex)
        {
            await
                WebHostErrorHandler
                    .HandleExceptionAsync(ex);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleNewCapture()
    {
        await
            InvokeAsync(async () =>
                {
                    try
                    {
                        _isLoading = true;
                        StateHasChanged();

                        // new capture would be the most recent; get the latest record
                        await
                            LoadBatchesAsync(
                                0,
                                1
                            );

                        Snackbar
                            .Add(
                                StringLocalizer["ScansNewScanReceivedMessage"].Value,
                                Severity.Success
                            );
                    }
                    catch (Exception ex)
                    {
                        await
                            WebHostErrorHandler
                                .HandleExceptionAsync(ex);
                    }
                    finally
                    {
                        _isLoading = false;
                        StateHasChanged();
                    }
                }
            );
    }

    private async Task LoadBatchesAsync(
        int index,
        int count
    )
    {
        var request =
            new MyBatchesRequest
            {
                StartIndex = index,
                RecordCount = count
            };

        var response =
            await
                ApiRequestManager
                    .Batches
                    .GetMyBatchesAsync(
                        request,
                        BaseCancellationToken
                    );

        _currentIndex +=
            (response?.Batches ?? [])
            .Count();

        _noMoreRecords = _currentIndex == (response?.TotalRecords ?? 0);

        var existingBatches = new List<BatchSummary>(_batches);
        var newBatches = new List<BatchSummary>(response?.Batches ?? []);

        _batches =
            existingBatches
                .UnionBy(
                    newBatches,
                    o => o.Id
                )
                .OrderByDescending(o => o.DateScanned);
    }

    private async Task ConfirmDeleteAsync(
        string id
    )
    {
        var dialog =
            await
                DialogService
                    .ShowAsync<ConfirmDeleteScanDialog>(
                        null
                    );

        var result =
            await
                dialog
                    .Result;

        if (!(result?.Canceled ?? true))
        {
            try
            {
                _isLoading = true;
                StateHasChanged();

                await
                    ApiRequestManager
                        .Batches
                        .DeleteBatchByIdAsync(
                            id,
                            BaseCancellationToken
                        );

                _batches =
                    _batches
                        .Where(o => o.Id != id);

                Snackbar
                    .Add(
                        StringLocalizer["ScansWasDeletedMessage"].Value,
                        Severity.Success
                    );
            }
            catch (Exception ex)
            {
                await
                    WebHostErrorHandler
                        .HandleExceptionAsync(ex);
            }
            finally
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Clean up SignalR subscription
        CaptureHubClient.OnNewCaptureReceived -= HandleNewCapture;

        await
            CaptureHubClient
                .StopAsync();
    }
    
}